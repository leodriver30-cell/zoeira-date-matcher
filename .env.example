# Server Configuration
HOST=0.0.0.0
PORT=8050

# WhatsApp Robot Integration (CallMeBot) - Optional
# 1. Add contact +34 941 01 99 99 on WhatsApp
# 2. Send: "I allow callmebot to send me messages"
# 3. Enter received API key below
DEFAULT_CREATOR_PHONE=
CALLMEBOT_API_KEY=

# Facebook Messenger Bot (Optional - Meta Graph API)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_WEBHOOK_URL=

# Generic Webhook (n8n, Make, Zapier, Discord) - Optional
DEFAULT_WEBHOOK_URL=

# Google Calendar OAuth (Optional for free/busy slot sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8050/auth/google/callback
